{
  "color-fg": {
    "$type": "color",
    "$description": "Primary ink color for body text on the warm paper background",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1216, 0.1412, 0.1255],
      "hex": "#1f2420"
    }
  },
  "color-bg": {
    "$type": "color",
    "$description": "Warm paper background for the app surface",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.9843, 0.9725, 0.9529],
      "hex": "#fbf8f3"
    }
  },
  "color-primary": {
    "$type": "color",
    "$description": "Primary brand color, a deep ledger-emerald used for key actions",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.0784, 0.3882, 0.3373],
      "hex": "#146356"
    }
  },
  "color-primary-fg": {
    "$type": "color",
    "$description": "Text/icon color placed on top of color-primary",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    }
  },
  "color-border": {
    "$type": "color",
    "$description": "Default border color for cards, inputs and dividers, warm tan",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.8667, 0.8314, 0.7686],
      "hex": "#ddd4c4"
    }
  },
  "color-muted": {
    "$type": "color",
    "$description": "Secondary text color for captions and helper copy",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.3529, 0.3765, 0.3451],
      "hex": "#5a6058"
    }
  },
  "color-positive": {
    "$type": "color",
    "$description": "Text/accent color for income and positive amounts",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.0902, 0.4196, 0.2510],
      "hex": "#176b40"
    }
  },
  "color-negative": {
    "$type": "color",
    "$description": "Text/accent color for expenses and negative amounts",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.6980, 0.2275, 0.1804],
      "hex": "#b23a2e"
    }
  },
  "space-1": {
    "$type": "dimension",
    "$description": "Smallest spacing unit",
    "$value": { "value": 4, "unit": "px" }
  },
  "space-2": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" }
  },
  "space-3": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" }
  },
  "space-4": {
    "$type": "dimension",
    "$value": { "value": 24, "unit": "px" }
  },
  "radius-sm": {
    "$type": "dimension",
    "$description": "Tight corner radius for chips and inputs",
    "$value": { "value": 6, "unit": "px" }
  },
  "radius-md": {
    "$type": "dimension",
    "$description": "Standard corner radius for buttons",
    "$value": { "value": 12, "unit": "px" }
  },
  "radius-lg": {
    "$type": "dimension",
    "$description": "Generous corner radius for cards and surfaces",
    "$value": { "value": 24, "unit": "px" }
  },
  "font-size-sm": {
    "$type": "dimension",
    "$value": { "value": 13, "unit": "px" }
  },
  "font-size-md": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" }
  },
  "font-size-lg": {
    "$type": "dimension",
    "$value": { "value": 28, "unit": "px" }
  },
  "font-size-xl": {
    "$type": "dimension",
    "$description": "Hero/page-title size",
    "$value": { "value": 40, "unit": "px" }
  },
  "font-family-base": {
    "$type": "fontFamily",
    "$description": "Body copy typeface: a humanist sans for UI text",
    "$value": "'IBM Plex Sans', -apple-system, 'Segoe UI', Roboto, sans-serif"
  },
  "font-family-heading": {
    "$type": "fontFamily",
    "$description": "Editorial serif for headings, giving the ledger a distinct voice",
    "$value": "'IBM Plex Serif', Georgia, 'Times New Roman', serif"
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400
  },
  "font-weight-medium": {
    "$type": "fontWeight",
    "$value": 500
  },
  "font-weight-bold": {
    "$type": "fontWeight",
    "$value": 700
  },
  "border-width-thin": {
    "$type": "dimension",
    "$description": "Default hairline border width",
    "$value": { "value": 1, "unit": "px" }
  },
  "focus-ring-width": {
    "$type": "dimension",
    "$description": "Width of the focus outline on interactive elements",
    "$value": { "value": 2, "unit": "px" }
  },
  "focus-ring-offset": {
    "$type": "dimension",
    "$value": { "value": 1, "unit": "px" }
  },
  "shadow-card": {
    "$type": "shadow",
    "$description": "Default resting elevation for cards",
    "$value": {
      "color": { "colorSpace": "srgb", "components": [0.1216, 0.1412, 0.1255], "hex": "#1f2420", "alpha": 0.1 },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 4, "unit": "px" },
      "blur": { "value": 12, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  },
  "button-primary-background": {
    "$type": "color",
    "$description": "Background of the primary button variant",
    "$value": "{color-primary}"
  },
  "button-primary-foreground": {
    "$type": "color",
    "$description": "Text color of the primary button variant",
    "$value": "{color-primary-fg}"
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "button-primary-padding-x": {
    "$type": "dimension",
    "$value": "{space-3}"
  },
  "button-primary-padding-y": {
    "$type": "dimension",
    "$value": "{space-2}"
  },
  "card-default-background": {
    "$type": "color",
    "$description": "Background of the default card component",
    "$value": "{color-bg}"
  },
  "card-default-border": {
    "$type": "color",
    "$description": "Border color of the default card component",
    "$value": "{color-border}"
  },
  "card-default-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },
  "card-default-padding": {
    "$type": "dimension",
    "$value": "{space-4}"
  }
}
